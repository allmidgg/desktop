{
  "name": "allmid",
  "version": "0.1.0",
  "description": "Stats, scouting en overlay voor League of Legends Classic (JADE)",
  "author": "AllMid",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-builder --config electron-builder.yml --publish never",
    "start": "electron-vite preview",
    "manager:dev": "electron-vite dev --config manager/electron.vite.config.ts",
    "manager:build": "electron-vite build --config manager/electron.vite.config.ts",
    "manager:package": "electron-builder --config manager/electron-builder.yml --publish never",
    "scout": "tsx src/cli/scout.ts",
    "loadout": "tsx src/cli/loadout.ts",
    "runes": "tsx src/cli/runes.ts",
    "typecheck": "tsc --noEmit",
    "crawl": "tsx src/cli/crawl.ts",
    "riot-probe": "tsx src/cli/riot-probe.ts",
    "stats": "tsx src/cli/stats.ts",
    "live": "tsx src/cli/live.ts",
    "server": "tsx server/index.ts",
    "upload": "tsx src/cli/upload.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "undici": "^7.2.0",
    "ws": "^8.18.0"
