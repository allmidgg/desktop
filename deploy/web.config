<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS-configuratie voor allmid.gg.

  Dit bestand hoort in de hoofdmap van de site op de server, naast index.html.

  Twee dingen gebeuren hier:
    1. de statische pagina wordt geserveerd, met compressie en verstandige
       cachetijden;
    2. alles onder /api/ gaat door naar de verzamelserver, die op localhost
       draait en niet rechtstreeks vanaf het internet bereikbaar is.

  Voor punt 2 zijn twee gratis IIS-modules nodig: URL Rewrite en Application
  Request Routing. Staan die er niet, dan geeft IIS een 500 op dit bestand.
  Zie deploy/README.md.
-->
<configuration>
  <system.webServer>

    <!-- ── De verzamelserver ────────────────────────────────────────────────
         /api/v1/... gaat naar de Node-server op poort 8123. Die luistert op
         127.0.0.1, dus dit is de enige weg naar binnen en de snelheidsbegrenzing
         valt niet te omzeilen.
    -->
    <rewrite>
      <rules>
        <rule name="allmid-api" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8123/api/{R:1}" />
        </rule>
      </rules>
      <outboundRules>
        <!-- De proxy mag zichzelf niet verraden in de antwoordkoppen. -->
        <rule name="verberg-backend">
          <match serverVariable="RESPONSE_Server" pattern=".*" />
          <action type="Rewrite" value="" />
        </rule>
      </outboundRules>
    </rewrite>

    <!-- ── Statische bestanden ─────────────────────────────────────────────-->
    <staticContent>
      <!-- IIS kent deze van huis uit niet allemaal. -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <httpCompression directory="%SystemDrive%\inetpub\temp\IIS Temporary Compressed Files">
      <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll" staticCompressionLevel="9" />
      <staticTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="image/svg+xml" enabled="true" />
        <add mimeType="*/*" enabled="false" />
      </staticTypes>
    </httpCompression>
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <httpProtocol>
      <customHeaders>
        <!-- IIS zet standaard zijn versienummer in elk antwoord. Niet nodig. -->
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <!--
          De pagina laadt alleen eigen bestanden en Google Fonts. Alles wat
          daarbuiten valt hoort geweigerd te worden: dit is een downloadpagina
          voor een .exe, dus een geinjecteerd script zou hier veel schade doen.
        -->
        <add name="Content-Security-Policy"
             value="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" />
      </customHeaders>
    </httpProtocol>

    <!-- Standaard geen fout-details naar buiten. -->
    <httpErrors errorMode="Custom" existingResponse="Auto" />

    <security>
      <requestFiltering>
        <!-- Uploads gaan via /api/, en de server begrenst zelf op 8 MB. -->
        <requestLimits maxAllowedContentLength="10485760" />
        <hiddenSegments>
          <add segment="_var-c.html" />
        </hiddenSegments>
      </requestFiltering>
    </security>

  </system.webServer>

  <!-- ── Cachetijden ──────────────────────────────────────────────────────
       Beeldmateriaal verandert nooit zonder nieuwe bestandsnaam, dus dat mag
       lang blijven staan. De pagina en de cijfers moeten juist snel verversen,
       anders zien bezoekers na een data-update nog dagen de oude getallen.
  -->
  <location path="img">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="data">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:05:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:05:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
